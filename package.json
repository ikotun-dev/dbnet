{
  "name": "dbnet",
  "version": "0.1.1",
  "description": "A local-first PostgreSQL and MySQL workspace that runs in your browser.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikotun-dev/dbnet.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "assets:sync": "node scripts/sync-assets.mjs",
    "build:cli": "npm run build && npm run assets:sync && go build -trimpath -o bin/dbnet ./cmd/dbnet",
    "test": "node --test lib/connection-url.test.mjs && go test ./..."
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
